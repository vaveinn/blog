---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

const { page } = Astro.props;

let delay = 0;
const interval = 50;
const isHome = page.currentPage === 1;

let randomCovers: string[] = [];
const canFetch = typeof fetch === "function";
if (isHome && canFetch) {
	try {
		const response = await fetch(
			"https://wallhaven.cc/api/v1/search?categories=010&purity=100&sorting=random&ratios=16x9&atleast=1280x720",
		);
		if (response.ok) {
			const payload = await response.json();
			randomCovers =
				payload?.data
					?.map((item) => item?.thumbs?.large || item?.path)
					.filter(Boolean) ?? [];
		}
	} catch (error) {
		console.warn("[PostPage] Failed to fetch Wallhaven covers.", error);
	}
} else if (isHome && !canFetch) {
	console.warn("[PostPage] Global fetch is unavailable during build.");
}
---
<div class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4 mb-4">
    {page.data.map((entry: CollectionEntry<"posts">, index: number) => {
        const randomCover =
            isHome && randomCovers.length > 0
                ? randomCovers[index % randomCovers.length]
                : undefined;

        const coverImage = isHome ? "" : entry.data.image;

        return (
            <PostCard
                    entry={entry}
                    title={entry.data.title}
                    tags={entry.data.tags}
                    category={entry.data.category}
                    published={entry.data.published}
                    updated={entry.data.updated}
                    url={getPostUrlBySlug(entry.slug)}
                    image={coverImage}
                    randomCover={randomCover}
                    description={entry.data.description}
                    draft={entry.data.draft}
                    class:list="onload-animation"
                    style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
            ></PostCard>
        );
    })}
</div>
