---
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";
import sharp from "sharp";

const { page } = Astro.props;

let delay = 0;
const interval = 50;
const isHome = page.currentPage === 1;

let randomCovers: string[] = [];
const canFetch = typeof fetch === "function";
const MIN_WIDTH = 1920;
const MIN_HEIGHT = 1080;
if (isHome && canFetch) {
	try {
		const targetCount = Math.max(page.data.length, 1);
		const requestLimit = Math.min(Math.max(targetCount * 3, 8), 50);
		const response = await fetch(
			`https://api.nekosapi.com/v4/images/random?rating=safe&limit=${requestLimit}`,
		);
		if (response.ok) {
			const payload = await response.json();
			const items = Array.isArray(payload) ? payload : payload?.items ?? [];
			const fallbackCovers: string[] = [];

			for (const item of items) {
				const url = item?.url;
				if (!url) continue;
				fallbackCovers.push(url);

				try {
					const imageResponse = await fetch(url);
					if (!imageResponse.ok) continue;
					const buffer = Buffer.from(await imageResponse.arrayBuffer());
					const metadata = await sharp(buffer).metadata();
					const width = metadata.width ?? 0;
					const height = metadata.height ?? 0;
					if (width >= MIN_WIDTH && height >= MIN_HEIGHT) {
						randomCovers.push(url);
					}
				} catch (error) {
					console.warn("[PostPage] Failed to inspect image size.", error);
				}

				if (randomCovers.length >= targetCount) break;
			}

			if (randomCovers.length < targetCount) {
				const needed = targetCount - randomCovers.length;
				const fill = fallbackCovers.filter((url) => !randomCovers.includes(url));
				randomCovers.push(...fill.slice(0, needed));
			}
		}
	} catch (error) {
		console.warn("[PostPage] Failed to fetch Nekos API covers.", error);
	}
} else if (isHome && !canFetch) {
	console.warn("[PostPage] Global fetch is unavailable during build.");
}

const cards = page.data.map((entry: CollectionEntry<"posts">, index: number) => {
	const randomCover =
		isHome && randomCovers.length > 0
			? randomCovers[index % randomCovers.length]
			: undefined;
	const coverImage = isHome ? "" : entry.data.image;
	return { entry, randomCover, coverImage };
});
---
<div class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4 mb-4">
    {cards.map(({ entry, randomCover, coverImage }) => (
        <PostCard
                entry={entry}
                title={entry.data.title}
                tags={entry.data.tags}
                category={entry.data.category}
                published={entry.data.published}
                updated={entry.data.updated}
                url={getPostUrlBySlug(entry.slug)}
                image={coverImage}
                randomCover={randomCover}
                description={entry.data.description}
                draft={entry.data.draft}
                class:list="onload-animation"
                style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
        ></PostCard>
    ))}
</div>
