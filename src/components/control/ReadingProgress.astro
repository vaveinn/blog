---
import { Icon } from "astro-icon/components";
import type { MarkdownHeading } from "astro";

interface Props {
	headings?: MarkdownHeading[];
}

const headings = Astro.props.headings || [];

let minDepth = Number.POSITIVE_INFINITY;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}
if (!Number.isFinite(minDepth)) {
	minDepth = 1;
}

const displayHeadings = headings.filter((heading) => heading.depth <= minDepth + 2);
---

<div id="reading-progress" class="reading-progress">
	{
		displayHeadings.length > 0 && (
			<>
				<div id="article-outline-panel" class="article-outline-panel" aria-hidden="true">
					<div class="article-outline-panel-title">{"\u6587\u7ae0\u7ed3\u6784"}</div>
					<ul class="article-outline-panel-list">
						{displayHeadings.map((heading) => (
							<li>
								<a
									href={`#${heading.slug}`}
									class:list={[
										"article-outline-panel-link",
										{
											"level-1": heading.depth === minDepth,
											"level-2": heading.depth === minDepth + 1,
											"level-3": heading.depth >= minDepth + 2,
										},
									]}
								>
									{heading.text}
								</a>
							</li>
						))}
					</ul>
				</div>
				<button id="article-outline-btn" class="article-outline-btn" aria-label="显示文章结构" aria-expanded="false" title="显示文章结构">
					<Icon name="material-symbols:format-list-bulleted-rounded" class="article-outline-btn-icon"></Icon>
					<span class="article-outline-btn-text">文章结构</span>
				</button>
			</>
		)
	}
	<div class="reading-progress-card card-base">
		<button id="reading-progress-ring" class="reading-progress-ring" aria-label="当前文章阅读进度" title="当前文章阅读进度">
			<svg viewBox="0 0 48 48" aria-hidden="true">
				<circle class="ring-track" cx="24" cy="24" r="20"></circle>
				<circle id="reading-progress-bar" class="ring-bar" cx="24" cy="24" r="20"></circle>
			</svg>
			<span id="reading-progress-percent" class="ring-percent">0%</span>
		</button>
		<button id="reading-progress-top" class="reading-progress-top" aria-label="回到顶部" title="回到顶部">
			<Icon name="material-symbols:keyboard-arrow-up-rounded" class="top-icon"></Icon>
		</button>
	</div>
</div>

<style>
	.reading-progress {
		position: fixed;
		right: max(1rem, calc((100vw - var(--page-width)) / 2 + 1rem));
		bottom: 1.5rem;
		z-index: 40;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.5rem;
		opacity: 0;
		visibility: hidden;
		transform: translateY(0.75rem);
		transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
		pointer-events: none;
	}

	.reading-progress.show {
		opacity: 1;
		visibility: visible;
		transform: none;
		pointer-events: auto;
	}

	.article-outline-btn {
		width: auto;
		min-width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.85rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		padding: 0 0.85rem;
		color: var(--primary);
		background: var(--card-bg);
		border: 1px solid var(--line-color);
		transition: all 0.15s ease;
	}

	.article-outline-btn:hover,
	.article-outline-btn.active {
		background: var(--btn-card-bg-hover);
	}

	.article-outline-btn-icon {
		font-size: 1.5rem;
	}

	.article-outline-btn-text {
		font-size: 0.85rem;
		font-weight: 600;
		line-height: 1;
		white-space: nowrap;
	}

	.article-outline-panel {
		display: none;
		width: min(18rem, calc(100vw - 2rem));
		max-height: 55vh;
		overflow-y: auto;
		overflow-x: hidden;
		background: var(--card-bg);
		border: 1px solid var(--line-color);
		border-radius: var(--radius-large);
		box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
		padding: 0.75rem;
	}

	.article-outline-panel.open {
		display: block;
	}

	.article-outline-panel-title {
		display: flex;
		align-items: center;
		font-weight: 700;
		font-size: 0.95rem;
		color: rgb(0 0 0 / 0.85);
		margin-bottom: 0.5rem;
		padding-left: 0.65rem;
		border-left: 3px solid var(--primary);
	}

	.article-outline-panel-list {
		display: grid;
		gap: 0.15rem;
	}

	.article-outline-panel-link {
		display: block;
		padding: 0.45rem 0.55rem;
		border-radius: 0.6rem;
		line-height: 1.45;
		font-size: 0.9rem;
		color: rgb(0 0 0 / 0.72);
		transition: all 0.15s ease;
	}

	.article-outline-panel-link:hover {
		background: var(--btn-plain-bg-hover);
		color: var(--primary);
	}

	.article-outline-panel-link.active {
		background: var(--btn-plain-bg-hover);
		color: var(--primary);
		font-weight: 600;
	}

	.article-outline-panel-link.level-2 {
		padding-left: 1.15rem;
		font-size: 0.85rem;
	}

	.article-outline-panel-link.level-3 {
		padding-left: 1.6rem;
		font-size: 0.8rem;
		opacity: 0.9;
	}

	.reading-progress-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		padding: 0.5rem;
	}

	.reading-progress-ring {
		position: relative;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 9999px;
		background: transparent;
		cursor: pointer;
	}

	.reading-progress-ring svg {
		width: 100%;
		height: 100%;
		transform: rotate(-90deg);
	}

	.ring-track {
		fill: none;
		stroke: var(--btn-regular-bg);
		stroke-width: 4;
	}

	.ring-bar {
		fill: none;
		stroke: var(--primary);
		stroke-width: 4;
		stroke-linecap: round;
		stroke-dasharray: 125.66;
		stroke-dashoffset: 125.66;
	}

	.ring-percent {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--primary);
	}

	.reading-progress-top {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.65rem;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--primary);
		background: var(--btn-regular-bg);
		transition: all 0.15s ease;
	}

	.reading-progress-top:hover {
		background: var(--btn-regular-bg-hover);
	}

	.top-icon {
		font-size: 1.5rem;
	}

	:global(.dark) .article-outline-panel-title {
		color: rgb(255 255 255 / 0.85);
	}

	:global(.dark) .article-outline-panel-link {
		color: rgb(255 255 255 / 0.74);
	}
</style>

<script>
	const CIRCUMFERENCE = 2 * Math.PI * 20;

	const wrapper = document.getElementById("reading-progress");
	const bar = document.getElementById("reading-progress-bar");
	const percent = document.getElementById("reading-progress-percent");
	const topBtn = document.getElementById("reading-progress-top");
	const ringBtn = document.getElementById("reading-progress-ring");
	const outlineBtn = document.getElementById("article-outline-btn");
	const outlinePanel = document.getElementById("article-outline-panel");

	if (bar) {
		bar.style.strokeDasharray = `${CIRCUMFERENCE}`;
	}

	function openOutlinePanel() {
		outlinePanel?.classList.add("open");
		outlineBtn?.classList.add("active");
		outlineBtn?.setAttribute("aria-expanded", "true");
		outlinePanel?.setAttribute("aria-hidden", "false");
	}

	function closeOutlinePanel() {
		outlinePanel?.classList.remove("open");
		outlineBtn?.classList.remove("active");
		outlineBtn?.setAttribute("aria-expanded", "false");
		outlinePanel?.setAttribute("aria-hidden", "true");
	}

	function toggleOutlinePanel() {
		if (outlinePanel?.classList.contains("open")) {
			closeOutlinePanel();
		} else {
			openOutlinePanel();
		}
	}

	let outlineObserver = null;

	function initOutlineSpy() {
		outlineObserver?.disconnect();
		outlineObserver = null;
		if (!outlinePanel) return;
		const links = Array.from(outlinePanel.querySelectorAll<HTMLAnchorElement>("a[href^='#']"));
		if (links.length === 0) return;

		const targets = links
			.map((link) => ({
				link,
				target: document.getElementById(decodeURIComponent(link.hash.slice(1))),
			}))
			.filter(
				(item) =>
					item.target && typeof item.target === "object",
			) as { link: HTMLAnchorElement; target: HTMLElement }[];

		if (targets.length === 0) return;

		outlineObserver = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const current = targets.find((item) => item.target === entry.target);
					if (!current || !entry.isIntersecting) continue;
					links.forEach((link) => link.classList.remove("active"));
					current.link.classList.add("active");
				}
			},
			{ root: null, rootMargin: "-40% 0px -50% 0px", threshold: 0 },
		);

		targets.forEach((item) => outlineObserver?.observe(item.target));
	}

	function updateReadingProgress() {
		const article = document.querySelector("#post-container");
		if (!article) return;
		const total = article.offsetHeight - window.innerHeight;
		const progress =
			total > 0
				? Math.min(1, Math.max(0, -article.getBoundingClientRect().top / total))
				: 0;
		if (bar) {
			bar.style.strokeDashoffset = `${CIRCUMFERENCE * (1 - progress)}`;
		}
		if (percent) {
			percent.textContent = `${Math.round(progress * 100)}%`;
		}
	}

	function initReadingProgress() {
		const article = document.querySelector("#post-container");
		if (!article) {
			wrapper?.classList.remove("show");
			closeOutlinePanel();
			return;
		}
		wrapper?.classList.add("show");
		initOutlineSpy();
		updateReadingProgress();
	}

	function scrollToTop() {
		window.scrollTo({ top: 0, behavior: "smooth" });
	}

	topBtn?.addEventListener("click", scrollToTop);
	ringBtn?.addEventListener("click", scrollToTop);

	outlineBtn?.addEventListener("click", (event) => {
		event.stopPropagation();
		toggleOutlinePanel();
	});

	outlinePanel?.addEventListener("click", (event) => {
		const targetEl = event.target as Element | null;
		const link = targetEl?.closest("a[href^='#'");
		if (!link) return;
		event.preventDefault();
		const id = decodeURIComponent(link.hash.slice(1));
		const target = document.getElementById(id);
		if (target) {
			const top = target.getBoundingClientRect().top + window.scrollY - 96;
			window.scrollTo({ top, behavior: "smooth" });
		}
		closeOutlinePanel();
	});

	document.addEventListener("click", (event) => {
		const clickTarget = event.target as Element | null;
		if (
			outlinePanel?.classList.contains("open") &&
			(!clickTarget || !clickTarget.closest("#reading-progress"))
		) {
			closeOutlinePanel();
		}
	});

	window.addEventListener("scroll", updateReadingProgress, { passive: true });
	window.addEventListener("resize", updateReadingProgress);
	window.addEventListener("load", initReadingProgress);
	window.addEventListener("pageshow", (event) => {
		if (event.persisted) {
			initReadingProgress();
		}
	});
	document.addEventListener("DOMContentLoaded", initReadingProgress);
	document.addEventListener("swup:contentReplaced", initReadingProgress);

	initReadingProgress();
</script>
