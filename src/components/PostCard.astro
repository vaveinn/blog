---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	randomCover?: string;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	randomCover,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;

const coverSrc = randomCover || image;
const hasCover = coverSrc !== undefined && coverSrc !== null && coverSrc !== "";

const { remarkPluginFrontmatter } = await entry.render();
---
<div class:list={["card-base w-full rounded-[var(--radius-large)] overflow-hidden relative bg-[var(--card-bg)]", className]} style={style}>
    <a href={url} aria-label={title} class="group block">
        <div class="relative w-full aspect-[16/9] overflow-hidden">
            {hasCover && (
                <>
                    <ImageWrapper
                        src={coverSrc}
                        basePath={path.join("content/posts/", getDir(entry.id))}
                        alt="Cover Image Background"
                        class="absolute inset-0 scale-[1.08] blur-2xl opacity-70"
                        fit="cover"
                    />
                    <div class="absolute inset-0 bg-gradient-to-br from-black/30 via-black/10 to-black/60"></div>
                    <div class="absolute inset-0 p-3 md:p-5">
                        <div class="relative h-full w-full rounded-2xl border border-white/20 dark:border-white/15 bg-white/10 dark:bg-black/25 backdrop-blur-md shadow-2xl">
                            <ImageWrapper
                                src={coverSrc}
                                basePath={path.join("content/posts/", getDir(entry.id))}
                                alt="Cover Image"
                                class="absolute inset-0"
                                fit="contain"
                            />
                        </div>
                    </div>
                </>
            )}
            {!hasCover && (
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_#f8fafc_0%,_#e2e8f0_45%,_#cbd5f5_100%)] dark:bg-[radial-gradient(circle_at_top,_#0f172a_0%,_#111827_45%,_#020617_100%)]"></div>
            )}
            <div class="absolute -right-16 -top-10 h-40 w-40 rounded-full bg-[color:var(--primary)] opacity-30 blur-3xl"></div>
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition bg-black/10"></div>
        </div>

        <div class="relative z-10 -mt-12 md:-mt-14 px-4 md:px-6 pb-6">
            <div class="rounded-2xl border border-black/5 dark:border-white/10 bg-white/85 dark:bg-black/60 backdrop-blur-md shadow-lg p-5 md:p-6">
                <div class="flex items-start justify-between gap-4">
                    <div
                        class="transition w-full block font-bold text-2xl md:text-3xl text-black/90 dark:text-white/90"
                    >
                        {title}
                    </div>
                    <Icon
                        class="text-[var(--primary)] text-[2rem] transition opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0"
                        name="material-symbols:chevron-right-rounded"
                    ></Icon>
                </div>

                <PostMetadata
                    published={published}
                    updated={updated}
                    tags={tags}
                    category={category}
                    hideTagsForMobile={true}
                    hideUpdateDate={true}
                    class="mt-3 mb-3"
                ></PostMetadata>

                <div class:list={["transition text-75 mb-3.5", {"line-clamp-2 md:line-clamp-1": !description}]}>
                    { description || remarkPluginFrontmatter.excerpt }
                </div>

                <div class="text-sm text-black/30 dark:text-white/30 flex gap-4 transition">
                    <div>
                        {remarkPluginFrontmatter.words} {" " + i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
                    </div>
                    <div>|</div>
                    <div>
                        {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                    </div>
                </div>
            </div>
        </div>
    </a>
</div>
<div class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"></div>
